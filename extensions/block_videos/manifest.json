{
  "manifest_version": 3,
  "name": "视频屏蔽插件",
  "version": "1.0",
  "description": "屏蔽指定网站上的所有视频，可点击切换是否屏蔽。",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
